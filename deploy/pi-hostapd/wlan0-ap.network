# Install as /etc/systemd/network/40-wlan0-ap.network. Gives wlan0 a static
# IP once NetworkManager stops managing it (see unmanaged-wlan0.conf) --
# hostapd itself brings the interface up, this just assigns the address.
[Match]
Name=wlan0

[Network]
Address=192.168.4.1/24
DHCPServer=no
IPv6AcceptRA=no
